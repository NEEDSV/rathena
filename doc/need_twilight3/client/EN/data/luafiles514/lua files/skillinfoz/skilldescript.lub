	[SKID.LG_PRESTIGE] = {
		"Prestige",
		"MAX Lv : 5",
		"^CC3399Requirement: Trample 3^000000",
		"Skill Form: ^3F0099Active^000000",
		"Description : ^777777  Prestige. Temporarily grants a magic evasion rate and raises defence. The magic evasion rate is affected by the caster's stats, and the defence increase is affected by the Defending Aura skill level. Succeeding at a magic evasion means taking no magic damage at all.^000000",
