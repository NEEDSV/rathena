	[SKID.RA_SENSITIVEKEEN] = {
		"Sensitive Keen",
		"MAX Lv : 5",
		"^777777Requirement : Tooth of Warg 3 ^000000",
		"Skill Form : ^777777 Active / Detecting  ^000000",
		"Description : ^777777  The wolf senses danger, finds and removes traps around the caster, and seeks out and attacks hidden enemies. The wolf has a chance to attack one of the targets in range with Warg Bite. ^000000",
		"[Level 1] : ^777777 AoE 7 x 7 / Damage 150% / Warg Bite combo chance 8% ^000000",
