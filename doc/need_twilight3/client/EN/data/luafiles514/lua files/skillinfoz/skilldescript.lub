		"[Level 3] : ^777777 Duration 60 sec   ^000000",
		"[Level 4] : ^777777 Duration 75 sec   ^000000",
		"[Level 5] : ^777777 Duration 90 sec   ^000000",
		"",
		"^00A0FF[Casting Info]^000000",
		"Lv.1 : Variable 2 sec / Fixed 1 sec / After Cast Delay 2 sec / Cooldown 540 sec",
		"Lv.2 : Variable 2 sec / Fixed 1 sec / After Cast Delay 2 sec / Cooldown 480 sec",
		"Lv.3 : Variable 2 sec / Fixed 1 sec / After Cast Delay 2 sec / Cooldown 420 sec",
