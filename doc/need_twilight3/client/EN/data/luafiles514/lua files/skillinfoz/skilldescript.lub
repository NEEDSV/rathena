	},
	[SKID.RA_CAMOUFLAGE] = {
		"Camouflage",
		"MAX Lv : 5",
		"^CC3399Requirement: Ranger Main 1^000000",
		"Skill Form: ^3F0099Active^000000",
		"Description : ^777777  When used, hides the body near a wall or obstacle so that monsters other than Demon and Insect types cannot detect you. While hidden the body appears semi-transparent. While Camouflage is in use critical rate and attack power rise, but defence falls instead. When Camouflage ends, attack power, critical rate and defence return to normal. Attacking or using a skill while in Camouflage cancels the state. SP is consumed continuously while Camouflage lasts. As the level rises, Camouflage can be used even when not near an obstacle.^000000",
		"[Lv 1]: ^7777776 SP per sec, Movement Disabled^000000",
		"[Lv 2]: ^7777775 SP per sec, Movement Disabled^000000",
		"[Lv 3]: ^7777774 SP per sec, 50% Movement^000000",
		"[Lv 4]: ^7777773 SP per sec, 75% Movement^000000",
		"[Lv 5]: ^7777772 SP per sec, 100% Movement^000000"
	},
	[SKID.RA_RESEARCHTRAP] = {
		"Trap Research",
		"MAX Lv : 5",
		"^777777Requirement : Claymore Trap 1, Remove Trap 1 ^000000",
		"Skill Form : ^777777  Passive  ^000000",
		"Description : ^777777  Increases the trap damage of Hunters and Rangers, and extends the main trap installation range and increases INT and MSP.  ^000000",
		"[Level 1] : ^777777 Extra Damage +40 / INT +1 / MSP +220  / Range +1 ^000000",
		"[Level 2] : ^777777 Extra Damage +80 / INT +2 / MSP +240  / Range +1 ^000000",
		"[Level 3] : ^777777 Extra Damage +120 / INT +3 / MSP +260  / Range +2 ^000000",
		"[Level 4] : ^777777 Extra Damage +160 / INT +4 / MSP +280  / Range +2 ^000000",
		"[Level 5] : ^777777 Extra Damage +200 / INT +5 / MSP +300  / Range +3 ^000000"
	},
	[SKID.RA_MAGENTATRAP] = {
		"Magenta Trap",
		"MAX Lv : 1",
		"^777777Requirement :  Trap Research 1 ^000000",
		"Skill Form : ^777777  Active / Trap   ^000000",
		"Description : ^777777  When a target approaches within the 3 x 3 cells around the installed trap, it permanently converts the property of the target and of every target in the 5 x 5 cells around it to Fire property. It does not apply to boss-type monsters and players, and installing the trap consumes 1 Scarlet Point and 1 <Special Alloy Trap>.  It can also be placed under the target's feet, but no more than 1 can be placed at once. ^000000",
		"",
		"^00A0FF[Casting Info]^000000",
		"After Cast Delay : 2 sec"
	},
	[SKID.RA_COBALTTRAP] = {
