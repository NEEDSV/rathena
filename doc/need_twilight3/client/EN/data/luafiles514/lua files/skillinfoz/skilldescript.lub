	},
	[SKID.AM_CULTIVATION] = {
		"Cultivation",
		"Skill Form: ^3F0099Active^000000",
		"Description : ^777777Cultivates an Embryo into a Homunculus. Success or failure is decided by chance and the base success rate rises with the skill level. It cannot be used while you already have a Homunculus, and a Homunculus created successfully automatically becomes the one you raise.^000000"
