	[SKID.LG_RAYOFGENESIS] = {
		"Genesis Ray",
		"MAX Lv : 5",
		"^777777Requirement : Grand Cross 5 ^000000",
		"Skill Form : ^777777  Active / Damage ^000000",
		"Description : ^777777  The wrath of god's messenger falls from the sky. Every target within a radius of 5 cells takes Holy property damage. The skill can be used when 2 or more Royal Guards are in the Banding state, or even with just 1 while the Inspiration skill is active.  The more Royal Guards in the Banding state, the more additional magic damage occurs. If the target is undead or demon type, it is Blinded with a 50% chance.^000000",
		"[Level 1] : ^777777 ATK physical 600% magic 300%  / HP Cost 3%  ^000000",
