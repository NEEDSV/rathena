	[SKID.LG_INSPIRATION] = {
		"Inspiration",
		"MAX Lv : 5",
		"^777777Requirement : Shield Spell 3, Ray of Genesis 4, Piety 5 ^000000",
		"Skill Form : ^777777  Active / Self Buff ^000000",
		"Description : ^777777  Holy spirit resonance. Takes the holy spirit into the body to temporarily raise HIT and stats and increase ATK and MHP. Certain buffs and status ailments are removed when the skill triggers, and during the duration the user is protected by an aura that nullifies certain buffs and status ailments entirely. However, HP and SP decrease continuously for the skill's duration, and when attacking the user also takes part of the damage it deals. When the duration ends or SP reaches 0, the skill is released automatically, and the HP loss effect can even kill the user. Using the skill drops 1% of experience, and this experience loss cannot be prevented by any effect. This skill cannot be used together with Banding or Prestige. ^000000",
		"^777777 Buffs and status ailments protected from removal : Poison, Blind, Stun, Silence, Confusion, Stone Curse, Sleep, Bleeding, Curse, Burning, Frozen, Freezing, Chill, Fear, Toxin, Paralysis, Venom Bleed, Magic Mushroom, Death Hurt, Pyrexia, Oblivion, Leech End, Deep Sleep, Frenzy, Masquerade (Body Painting, Enervation, Gloomy, Ignorance, Laziness, Unlucky, Weakness) ^000000",
