	[SKID.LG_OVERBRAND] = {
		"Over Brand",
		"MAX Lv : 5",
		"^777777Requirement : Moon Slasher 3, Pinpoint Attack 1  ^000000",
		"Skill Form : ^777777  Active / Damage ^000000",
		"Description : ^777777  Spear-only skill. Draws a cross of blood, making consecutive thrusts up to 6 cells away and swings up to 6 cells to the left and right.  A target that takes the swing damage is knocked back, and takes additional damage if it hits a wall or the like while being knocked back. Thrust damage rises with the caster's BaseLV and Spear Quicken level, and swing damage rises with the caster's BaseLV, STR and DEX. ^000000",
