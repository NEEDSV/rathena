	[SKID.LG_EARTHDRIVE] = {
		"Earth Drive",
		"MAX Lv : 5",
		"^777777Requirement : Reflect Damage Reduction 3 ^000000",
		"Skill Form : ^777777  Active / Damage ^000000",
		"Description : ^777777  Swings the shield widely to deal [Earth property] damage to every enemy around the user. Enemies damaged by this attack have DEF and ASPD reduced by 25%, ground magic is removed, and enemies in the Hiding state can also be attacked. The higher the skill level, the longer the ASPD and DEF reduction lasts. Damage rises with the shield's weight.  There is a low chance that the shield is destroyed.^000000",
