	[SKID.NC_MADOLICENCE] = {
		"Mado Gear License",
		"MAX Lv : 5",
		"^777777Requirement : Mechanic basics  ^000000",
		"Skill Form : ^777777  Passive ^000000",
		"Description : ^777777  Learns the basic ability needed to operate a Mado Gear. Attack power while riding a Mado Gear improves, and without this skill movement speed drops while riding a Mado Gear; it gets faster as the skill level rises. ^000000",
		"^777777In the Mado Gear state, natural HP recovery increases, and it is not affected by some movement speed increase/decrease options or by recovery skills and Strip-class skills. ^000000",
		"[Level 1] : ^777777 ATK +15 while riding a Mado Gear  / Movement Speed -40% ^000000",
		"[Level 2] : ^777777 ATK +30 while riding a Mado Gear  / Movement Speed -30% ^000000",
