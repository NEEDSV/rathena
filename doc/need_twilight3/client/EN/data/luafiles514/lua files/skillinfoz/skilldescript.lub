	[SKID.NC_ARMSCANNON] = {
		"Arm Cannon",
		"MAX Lv : 3",
		"^777777Requirement : Flame Launcher 2, Cold Slower 2  ^000000",
		"Skill Form : ^777777  Active / Damage ^000000",
		"Description : ^777777  Fires the Cannon Ball loaded in the Mado Gear to attack 1 target and every enemy in the range around it. The damage property changes with the type of Cannon Ball, and the smaller the target's size, the greater the damage. Using the skill consumes 1 Mado Gear Fuel and 1 loaded Cannon Ball. ^000000",
		"[Level 1] : ^777777 ATK 700% / 650% / 600%  / Range 9 cells / AoE 7 x 7 cells^000000",
