# NEED Summer Monitor - environment template. Copy to .env (or export in the shell/service).
# NEVER commit real secrets. .env is gitignored.

# ---- HTTP ----
PORT=8787
HOST=0.0.0.0
# Set to 1 only when served over HTTPS (adds Secure flag to the session cookie).
COOKIE_SECURE=0

# ---- Operator login (required) ----
MONITOR_USER=admin
MONITOR_PASS=change-me-please
# Random string, >= 16 chars. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-32+random-chars
SESSION_TTL_HOURS=12

# ---- Database (SELECT-only account strongly recommended) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nsm_reader
DB_PASS=reader-password
# Main game DB: holds `char` and `need_summer_reward_log`
DB_NAME=ragnarok
# Log DB: holds picklog / zenylog / loginlog. Leave equal to DB_NAME if logs share the schema (dev default).
LOG_DB_NAME=ragnarok
# loginlog table name (rAthena config log_login_db). Usually loginlog.
LOG_LOGIN_TABLE=loginlog
DB_POOL=5
