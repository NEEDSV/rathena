# NEED Summer Monitor - local run config (Windows -> Linux DB via SSH tunnel)
# This file is gitignored. Fill every ==CHANGE== value. Do NOT put comments after a value.

# ---- SSH tunnel (Windows -> Linux) ----
# SSH_USER: linux ssh account (e.g. root / ops)
SSH_USER===CHANGE==
# SSH_HOST: linux host or IP (e.g. 192.168.0.10)
SSH_HOST===CHANGE==
SSH_PORT=22
# local port on Windows; the monitor connects here
TUNNEL_LOCAL_PORT=3307
# MySQL host/port as seen ON the linux box
REMOTE_DB_HOST=127.0.0.1
REMOTE_DB_PORT=3306

# ---- DB (SELECT-only account recommended) ----
# DB_HOST/DB_PORT are set to the tunnel (127.0.0.1:TUNNEL_LOCAL_PORT) by run-monitor.ps1.
DB_USER=nsm_reader
DB_PASS===CHANGE==
DB_NAME=ragnarok
LOG_DB_NAME=ragnarok

# ---- Operator login ----
MONITOR_USER=admin
MONITOR_PASS===CHANGE==
SESSION_SECRET=98ac290bfc07b26073b7593b5afe112eb011bb89c4389c086ec512b2619ecd48
SESSION_TTL_HOURS=12

# ---- HTTP ----
PORT=8787
