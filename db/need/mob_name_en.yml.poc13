###########################################################################
# NEED English Monster Display Name Database   (Phase 0.21 - PoC only)
###########################################################################
#
# Player-visible ENGLISH monster names for an EN session
# (map_session_data::need_lang). Read into s_mob_db::jname_en, which is
# DISPLAY ONLY and is compared by NO lookup path - mob_db_searchname and
# mob_db_searchname_array (mob.cpp:279-292) match sprite / name / jname and
# never this field, so a script `monster "...","<name>",id` and @monster
# keep resolving exactly as before.
#
# A monster whose display name was overridden at spawn time keeps that
# literal: mob_display_name() only substitutes while md.name still equals
# db->jname (conf/battle/monster.conf override_mob_names: 0 means a spawn
# file or script literal wins). Id 1039 below is in the table on purpose and
# is expected NOT to change on screen for that reason.
#
# This file is OPTIONAL. Deleting it returns every session to the Korean
# names and logs an [Info] line, not an [Error].
#
# GENERATED - regenerate with
#   en_build/script_localization/p21_poc_build.py --apply
###########################################################################
# - Id            monster id, must exist in mob_db
#   AegisName     checked against mob_db and never stored - it is only here
#                 so a row that has drifted is reported, not applied
#   NameEN        English display name. ASCII, at most 23 bytes.
###########################################################################

Header:
  Type: NEED_MOB_NAME_EN_DB
  Version: 1

Body:
# ---- field ----
  - Id: 1002
    AegisName: PORING
    NameEN: Poring
  - Id: 1007
    AegisName: FABRE
    NameEN: Fabre
  - Id: 1010
    AegisName: WILOW
    NameEN: Willow
  - Id: 1113
    AegisName: DROPS
    NameEN: Drops
